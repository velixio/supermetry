{
  "name": "supermetry-web",
  "private": true,
  "version": "0.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "bun scripts/copy-flags.mjs && vite",
    "gen:api": "openapi-typescript ../internal/api/openapi.yaml -o src/lib/api.gen.ts && bun run gen:api-client",
    "gen:api-client": "openapi-typescript ../internal/api/openapi.yaml -o packages/api-client/src/schema.ts",
    "gen:routes": "bun node_modules/@tanstack/router-cli/dist/esm/index.js generate",
    "typecheck": "bun run gen:routes && tsc --noEmit",
    "test": "bun packages/tokens/build.ts && vitest --configLoader runner --exclude=e2e/**",
    "build": "bun scripts/copy-flags.mjs && bun run gen:routes && tsc --noEmit && vite build --configLoader runner && bun scripts/size-check.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "^0.552.0",
    "next-themes": "^0.4.6",
    "openapi-fetch": "^0.17.0",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "4.11.2",
    "recharts": "^3.10.1",
    "rrweb-player": "^2.1.7",
    "shadcn": "^4.21.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-cli": "^1.167.40",
    "@tanstack/router-plugin": "^1.168.42",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "4.14.0",
    "country-flag-icons": "1.6.20",
    "jsdom": "^27.1.0",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
