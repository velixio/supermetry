{
  "resourceMetrics": [{
    "resource": {"attributes": [
      {"key": "service.name", "value": {"stringValue": "billing"}},
      {"key": "telemetry.sdk.language", "value": {"stringValue": "python"}}
    ]},
    "scopeMetrics": [{
      "scope": {"name": "app"},
      "metrics": [
        {"name": "queue.size", "unit": "1", "gauge": {"dataPoints": [
          {"attributes": [{"key": "queue", "value": {"stringValue": "a"}}], "timeUnixNano": @NOW@, "asInt": "12"},
          {"attributes": [{"key": "queue", "value": {"stringValue": "b"}}], "timeUnixNano": @NOW@, "asDouble": 3.5}
        ]}},
        {"name": "requests.total", "sum": {"aggregationTemporality": "AGGREGATION_TEMPORALITY_CUMULATIVE", "isMonotonic": true, "dataPoints": [
          {"startTimeUnixNano": "1700000000000000000", "timeUnixNano": @NOW@, "asInt": "4021"}
        ]}},
        {"name": "request.duration", "unit": "ms", "histogram": {"aggregationTemporality": 2, "dataPoints": [
          {"startTimeUnixNano": "1700000000000000000", "timeUnixNano": @NOW@, "count": "6", "sum": 310.5,
           "bucketCounts": ["1", "3", "2"], "explicitBounds": [50, 200], "min": 4, "max": 480}
        ]}},
        {"name": "latency.exp", "exponentialHistogram": {"aggregationTemporality": 2, "dataPoints": [
          {"timeUnixNano": @NOW@, "count": "1", "scale": 3}
        ]}}
      ]
    }]
  }]
}
