{
  "name": "@supermetry/nextjs",
  "version": "0.1.0",
  "description": "Supermetry analytics for the Next.js App Router, with a first-party proxy",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/velixio/supermetry.git",
    "directory": "sdk/nextjs"
  },
  "homepage": "https://github.com/velixio/supermetry/tree/main/sdk/nextjs#readme",
  "bugs": {
    "url": "https://github.com/velixio/supermetry/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./proxy": {
      "types": "./dist/proxy.d.ts",
      "default": "./dist/proxy.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE", "NOTICE"],
  "keywords": ["analytics", "supermetry", "nextjs", "react", "privacy", "tracking"],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "package:check": "node ../scripts/check-packages.mjs nextjs",
    "prepack": "bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supermetry/react": "workspace:*",
    "@supermetry/tracker": "workspace:*"
  },
  "peerDependencies": {
    "next": ">=14",
    "react": ">=18"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^18.0.1",
    "@types/bun": "^1.3.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3"
  }
}
