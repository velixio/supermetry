{
    "name": "supermetry/wordpress-plugin-dev",
    "description": "Development tooling (coding standards) for the Supermetry WordPress plugin. The plugin itself has no Composer dependencies.",
    "license": "GPL-2.0-or-later",
    "type": "project",
    "require-dev": {
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "wp-coding-standards/wpcs": "^3.1"
    },
    "scripts": {
        "lint": "phpcs"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    }
}
