---
import { pageLoadScript, scriptAttributes, type SupermetryProps } from "./dist/index.js";

export type Props = SupermetryProps;

const attributes = scriptAttributes(Astro.props);
---

{Astro.props.viewTransitions ? (
  <>
    <script is:inline {...attributes} data-astro-transition-persist="supermetry"></script>
    <script is:inline set:html={pageLoadScript}></script>
  </>
) : (
  <script is:inline {...attributes}></script>
)}
