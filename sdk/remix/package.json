{
  "name": "@supermetry/remix",
  "version": "0.2.0",
  "description": "Supermetry analytics for Remix and React Router 7, with a first-party proxy",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/velixio/supermetry.git",
    "directory": "sdk/remix"
  },
  "homepage": "https://supermetry.com",
  "bugs": {
    "url": "https://github.com/velixio/supermetry/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./router": {
      "types": "./dist/router.d.ts",
      "default": "./dist/router.js"
    },
    "./proxy": {
      "types": "./dist/proxy.d.ts",
      "default": "./dist/proxy.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE", "NOTICE"],
  "keywords": ["analytics", "supermetry", "remix", "react-router", "privacy", "tracking"],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "package:check": "node ../scripts/check-packages.mjs remix",
    "prepack": "bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supermetry/react": "workspace:*",
    "@supermetry/tracker": "workspace:*"
  },
  "peerDependencies": {
    "@remix-run/react": ">=2",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@remix-run/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^18.0.1",
    "@remix-run/react": "^2.17.1",
    "@types/bun": "^1.3.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "6.30.4",
    "typescript": "^5.9.3"
  }
}
