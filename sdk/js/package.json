{
  "name": "@supermetry/tracker",
  "version": "0.2.0",
  "description": "Typed browser wrapper for the Supermetry tracking script",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/velixio/supermetry.git",
    "directory": "sdk/js"
  },
  "homepage": "https://supermetry.com",
  "bugs": {
    "url": "https://github.com/velixio/supermetry/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./proxy": {
      "types": "./dist/proxy.d.ts",
      "default": "./dist/proxy.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE", "NOTICE"],
  "keywords": ["analytics", "supermetry", "privacy", "tracker", "browser"],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "package:check": "node ../scripts/check-packages.mjs js",
    "prepack": "bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "^1.3.1",
    "typescript": "^5.9.3"
  }
}
