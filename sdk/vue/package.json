{
  "name": "@supermetry/vue",
  "version": "0.1.0",
  "description": "Vue 3 plugin and composable for Supermetry analytics",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/velixio/supermetry.git",
    "directory": "sdk/vue"
  },
  "homepage": "https://github.com/velixio/supermetry/tree/main/sdk/vue#readme",
  "bugs": {
    "url": "https://github.com/velixio/supermetry/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE", "NOTICE"],
  "keywords": ["analytics", "supermetry", "vue", "privacy", "tracking"],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "package:check": "node ../scripts/check-packages.mjs vue",
    "prepack": "bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supermetry/tracker": "workspace:*"
  },
  "peerDependencies": {
    "vue": ">=3.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.1",
    "typescript": "^5.9.3",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3"
  }
}
