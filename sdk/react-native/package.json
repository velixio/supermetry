{
  "name": "@supermetry/react-native",
  "version": "0.2.0",
  "description": "React Native SDK for Supermetry self-hosted analytics",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/velixio/supermetry.git",
    "directory": "sdk/react-native"
  },
  "homepage": "https://supermetry.com",
  "bugs": {
    "url": "https://github.com/velixio/supermetry/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.js",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "keywords": [
    "analytics",
    "supermetry",
    "react-native",
    "mobile"
  ],
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts --outfile dist/index.js --format esm --target browser --packages external && bun build src/index.ts --outfile dist/index.cjs --format cjs --target browser --packages external && tsc -p tsconfig.build.json",
    "package:check": "node ../scripts/check-packages.mjs react-native",
    "prepack": "bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@react-native-async-storage/async-storage": ">=1.17",
    "react": ">=17",
    "react-native": ">=0.70"
  },
  "peerDependenciesMeta": {
    "@react-native-async-storage/async-storage": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "^1.3.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-native": "^0.87.1",
    "typescript": "^5.9.3"
  }
}
