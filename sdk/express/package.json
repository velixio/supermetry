{
  "name": "@supermetry/express",
  "version": "0.1.0",
  "description": "Express middleware for Supermetry self-hosted web analytics",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "keywords": ["analytics", "supermetry", "express", "middleware"],
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts --outfile dist/index.js --format esm --target node --packages external && bun build src/index.ts --outfile dist/index.cjs --format cjs --target node --packages external && tsc -p tsconfig.build.json",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supermetry/node": "workspace:*"
  },
  "peerDependencies": {
    "express": ">=4"
  },
  "devDependencies": {
    "@types/bun": "^1.3.1",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "express": "^5.1.0",
    "typescript": "^5.9.3"
  }
}
