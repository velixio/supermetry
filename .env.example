# Panel configuration. Copy to .env and fill in. `make run` loads .env.
# Only DATABASE_URL, BASE_URL and SECRET_KEY are required; everything else has a default.

# --- Required ---
# PostgreSQL 18 connection string.
PANEL_DATABASE_URL=postgres://panel:CHANGE_ME@127.0.0.1:5432/panel?sslmode=disable
# Public URL people use to reach this instance (http or https).
PANEL_BASE_URL=http://localhost:8080
# 32+ random bytes, base64. Encrypts TOTP and notification secrets. Generate: openssl rand -base64 32
PANEL_SECRET_KEY=

# --- Server ---
PANEL_LISTEN=:8080
# Comma-separated CIDRs whose X-Forwarded-For is trusted (your reverse proxy). Empty = trust none.
PANEL_TRUSTED_PROXIES=
# Optional bearer token for /metrics. Without one, only loopback clients may access metrics.
PANEL_METRICS_TOKEN=
# Public signup is invite-only by default. Set open to let anyone create an account and organization.
PANEL_SIGNUP=invite

# --- Tracking (rename paths to dodge ad-blockers) ---
PANEL_EVENT_PATH=/api/public/v1/events
PANEL_TRACKER_PATH=/js/script.js
# Empty = use the bundled DB-IP Lite country database.
PANEL_GEOIP_PATH=

# --- GeoIP updates (optional) ---
# Set both credentials to download MaxMind GeoLite2 databases. The license key
# is a secret: do not log it or commit a populated .env file.
PANEL_MAXMIND_ACCOUNT_ID=
PANEL_MAXMIND_LICENSE_KEY=
# Allowed: GeoLite2-City, GeoLite2-ASN, GeoLite2-Country.
PANEL_MAXMIND_EDITIONS=GeoLite2-City,GeoLite2-ASN
# Downloaded databases are stored here. Panel creates this directory with 0700 permissions.
PANEL_DATA_DIR=./data

# --- Ingest tuning ---
PANEL_QUEUE_SIZE=65536
PANEL_FLUSH_EVERY=1s
PANEL_SESSION_FLUSH=10s
PANEL_QUERY_TIMEOUT=10s

# --- Email (optional; enables invitations by email, password reset links, reports) ---
PANEL_SMTP_HOST=
PANEL_SMTP_PORT=587
PANEL_SMTP_USER=
PANEL_SMTP_PASS=
PANEL_SMTP_FROM=
PANEL_SMTP_STARTTLS=true

# --- Webhooks ---
# Development only. Production webhook, Slack and Discord destinations reject private, loopback and link-local IPs.
PANEL_ALLOW_PRIVATE_WEBHOOKS=false

# --- Session replay (off by default) ---
# The only switch: true turns replay on for every site. The dashboard shows the status but cannot change it.
PANEL_REPLAY_ENABLED=false
# Each of these, when set, wins over the dashboard and shows there read-only. Leave empty to edit it in the UI.
# Mask all page text and inputs (password, card and hidden fields are always masked).
PANEL_REPLAY_MASK=
# Percent of sessions recorded in full (0-100; default 15).
PANEL_REPLAY_SAMPLE_RATE=
# Days to keep replays (1-365; default 30).
PANEL_REPLAY_RETENTION_DAYS=
# Storage per site, e.g. 5GB or 500MB (default 5GB); the oldest replays are deleted when full.
PANEL_REPLAY_QUOTA=
# Local storage directory (default $PANEL_DATA_DIR/replay).
PANEL_REPLAY_DIR=
# S3-compatible storage: set endpoint, bucket, region, access key and secret key together (prefix is optional).
PANEL_REPLAY_S3_ENDPOINT=
PANEL_REPLAY_S3_BUCKET=
PANEL_REPLAY_S3_REGION=
PANEL_REPLAY_S3_ACCESS_KEY=
PANEL_REPLAY_S3_SECRET_KEY=
PANEL_REPLAY_S3_PREFIX=

# --- Development / benchmarks only ---
# Static admin API key for the public API (leave empty in production).
PANEL_ADMIN_API_KEY=
# JSON site list used only while no platform user exists (benchmarks).
PANEL_SITES_FILE=
