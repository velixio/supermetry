# Supermetry configuration. Copy to .env and fill in. `make run` loads .env.
# Only DATABASE_URL, BASE_URL and SECRET_KEY are required; everything else has a default.

# --- Required ---
# PostgreSQL 18 connection string.
SUPERMETRY_DATABASE_URL=postgres://supermetry:CHANGE_ME@127.0.0.1:5432/supermetry?sslmode=disable
# Public URL people use to reach this instance (http or https).
SUPERMETRY_BASE_URL=http://localhost:8080
# Public brand/homepage link shown by the OSS UI. This never changes auth,
# API, tracker, email-link, or cookie origins.
SUPERMETRY_HOMEPAGE_URL=https://supermetry.com
# 32+ random bytes, base64. Encrypts TOTP and notification secrets. Generate: openssl rand -base64 32
SUPERMETRY_SECRET_KEY=

# --- Server ---
SUPERMETRY_LISTEN=:8080
# Comma-separated CIDRs whose X-Forwarded-For is trusted (your reverse proxy). Empty = trust none.
SUPERMETRY_TRUSTED_PROXIES=
# Optional bearer token for /metrics. Without one, only loopback clients may access metrics.
SUPERMETRY_METRICS_TOKEN=
# Public signup is invite-only by default. Set open to let anyone create an account and organization.
SUPERMETRY_SIGNUP=invite
# Maximum time to read a request body and write a non-streaming response.
SUPERMETRY_HTTP_READ_TIMEOUT=30s
SUPERMETRY_HTTP_WRITE_TIMEOUT=60s

# --- Tracking (rename paths to dodge ad-blockers) ---
SUPERMETRY_EVENT_PATH=/api/public/v1/events
SUPERMETRY_TRACKER_PATH=/js/script.js
# Exact operator-reviewed public path literals only; no globs, IDs, or secrets.
# Absent or [] denies all anonymous paths. Changes require a coordinated restart.
# Example: SUPERMETRY_TRACKING_PUBLIC_PATHS='["/","/pricing"]'
SUPERMETRY_TRACKING_PUBLIC_PATHS='[]'
# Empty = use the bundled DB-IP Lite country database.
SUPERMETRY_GEOIP_PATH=

# --- GeoIP updates (optional) ---
# Set both credentials to download MaxMind GeoLite2 databases. The license key
# is a secret: do not log it or commit a populated .env file.
SUPERMETRY_MAXMIND_ACCOUNT_ID=
SUPERMETRY_MAXMIND_LICENSE_KEY=
# Allowed: GeoLite2-City, GeoLite2-ASN, GeoLite2-Country.
SUPERMETRY_MAXMIND_EDITIONS=GeoLite2-City,GeoLite2-ASN
# Downloaded databases are stored here. Supermetry creates this directory with 0700 permissions.
SUPERMETRY_DATA_DIR=./data

# --- Ingest tuning ---
SUPERMETRY_QUEUE_SIZE=65536
SUPERMETRY_FLUSH_EVERY=1s
SUPERMETRY_SESSION_FLUSH=10s
SUPERMETRY_QUERY_TIMEOUT=10s

# --- Email (optional; enables invitations by email, password reset links, reports) ---
SUPERMETRY_SMTP_HOST=
SUPERMETRY_SMTP_PORT=587
SUPERMETRY_SMTP_USER=
SUPERMETRY_SMTP_PASS=
SUPERMETRY_SMTP_FROM=
SUPERMETRY_SMTP_STARTTLS=true

# --- Webhooks ---
# Development only. Production webhook, Slack and Discord destinations reject private, loopback and link-local IPs.
SUPERMETRY_ALLOW_PRIVATE_WEBHOOKS=false

# --- Tracking privacy ---
# New installs default anonymous. Existing profile-enabled sites require an
# explicit choice: identified to continue profiles, or anonymous to disable new
# identity collection and ordinary historical identity reads without deleting data.
# Changing this setting requires a coordinated maintenance restart.
# SUPERMETRY_TRACKING_MODE=anonymous

# --- Session replay (off by default) ---
# Instance permission only: each project must also opt in. Independent of tracking mode.
SUPERMETRY_REPLAY_ENABLED=false
# Privacy values below are requirements/caps. Projects may tighten them, never weaken them.
# Leave empty to use project values/defaults. Storage credentials still use environment precedence.
# Mask all page text and inputs (password, card and hidden fields are always masked).
SUPERMETRY_REPLAY_MASK=
# Maximum sampled percent, including triggered recordings (0-100; default 15).
SUPERMETRY_REPLAY_SAMPLE_RATE=
# Days to keep replays (1-365; default 30).
SUPERMETRY_REPLAY_RETENTION_DAYS=
# Storage target per site, e.g. 5GB or 500MB (default 5GB); asynchronous retention
# deletes oldest inactive recordings. This is not an instantaneous byte admission limit.
SUPERMETRY_REPLAY_QUOTA=
# Local storage directory (default $SUPERMETRY_DATA_DIR/replay).
SUPERMETRY_REPLAY_DIR=
# S3-compatible storage: set endpoint, bucket, region, access key and secret key together (prefix is optional).
SUPERMETRY_REPLAY_S3_ENDPOINT=
SUPERMETRY_REPLAY_S3_BUCKET=
SUPERMETRY_REPLAY_S3_REGION=
SUPERMETRY_REPLAY_S3_ACCESS_KEY=
SUPERMETRY_REPLAY_S3_SECRET_KEY=
SUPERMETRY_REPLAY_S3_PREFIX=

# --- Development / benchmarks only ---
# Static admin API key for the public API (leave empty in production).
SUPERMETRY_ADMIN_API_KEY=
# JSON site list used only while no platform user exists (benchmarks).
SUPERMETRY_SITES_FILE=
