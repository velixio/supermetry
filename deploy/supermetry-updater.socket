[Unit]
Description=Supermetry update control socket

[Socket]
ExecStartPre=/usr/bin/install -d -o root -g supermetry-updater -m 0750 /run/supermetry-updater
ListenStream=/run/supermetry-updater/control.sock
SocketUser=root
SocketGroup=supermetry-updater
SocketMode=0660
DirectoryMode=0750
RemoveOnStop=true

[Install]
WantedBy=sockets.target
